# WebSocket origin of the deployed room Durable Object Worker.
#
# Leave unset for local development: the client falls back to the address that
# `npm run dev:room` (wrangler dev) listens on, but only when the page itself
# is served from localhost.
#
# Required for any deployed build. Without it the client throws a clear error
# on connect instead of silently dialling 127.0.0.1 and hanging on
# "Connecting…" forever.
#
#   NEXT_PUBLIC_ROOM_WS_URL=wss://party-plus-room.<your-subdomain>.workers.dev
NEXT_PUBLIC_ROOM_WS_URL=
